{
	"FileVersion": 3,
	"Version": 2,
	"VersionName": "2.0",
	"FriendlyName": "Mapbox Landscape",
	"Description": "Fetches Mapbox terrain, satellite and metadata tiles and creates real-world UE landscapes with user-defined layer rules and PCG scatter. Requires your own Mapbox API key; subject to Mapbox Terms of Service.",
	"Category": "Landscape",
	"CreatedBy": "BerjisTech",
	"CreatedByURL": "https://github.com/BerjisTech",
	"DocsURL": "https://github.com/BerjisTech/MapboxLandscape/tree/master/wiki",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/BerjisTech/MapboxLandscape/issues",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "MapboxLandscape",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64" ]
		}
	],
	"Plugins": [
		{
			"Name": "LandscapePatch",
			"Enabled": true
		},
		{
			"Name": "PCG",
			"Enabled": true
		},
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		}
	]
}
